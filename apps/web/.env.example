# Where your animations live, for `pnpm dev`. Copy this file to `.env.local` and edit it.
# Neither variable is used by the deployed app — it has no server and reads no disk.

# The folder every path is relative to. The dev server, the sync hub (`pnpm sync`) and the
# MCP server all read it, and they have to agree: a path travels between them as text, so
# a hub rooted elsewhere resolves the editor's paths against the wrong tree.
# Default: the repository root.
# LOTTIE_WORKSPACE=/Users/you/work/brand-animations

# Comma-separated folders inside it to browse, searched recursively. A folder that is not
# there is skipped. Default: lotties,lotties-light
# LOTTIE_DIRS=source,converted

# Port the sync hub listens on. Default: 4319
# LOTTIE_THEME_SYNC_PORT=4319
